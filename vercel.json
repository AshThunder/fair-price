{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|assets/|.*\\.[a-z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "regions": [
    "iad1"
  ]
}
